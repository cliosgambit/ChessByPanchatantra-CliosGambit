# Local SQLite (optional; default: backend/data/clio.db)
# SQLITE_PATH=

# Supabase (backend only — Dashboard → Project Settings → API)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Required for schema + data migration (Dashboard → Database → Connection string → URI)
DATABASE_URL=

# Auth
JWT_SECRET=

# Email (OTP) — use a Gmail App Password (Google Account → Security → 2-Step Verification → App passwords)
# Paste the 16-character password; spaces are optional.
GMAIL_USER=
GMAIL_APP_PASS=
