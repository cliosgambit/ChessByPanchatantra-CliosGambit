  "changesNeededForClio": [
    {
      "id": 1,
      "area": "backend",
      "change": "Add POST /api/analyze-game proxy to https://stockfish-cbp.onrender.com/analyze-game",
      "detail": "Accept { pgn, depth?, movetime?, multipv? }. Forward to hosted. Optional local fallback: parse PGN with chess.js and loop analyzePosition per ply."
    },
    {
      "id": 2,
      "area": "backend adapter",
      "change": "Normalize hosted timeline into CLIO analysis[] shape",
      "mapping": {
        "win_probability": "winProbability",
        "previous_fen_bestmove": "previousFenBestmove",
        "analysis[].rank": "lines[].multipv",
        "analysis[].cp/mate": "lines[].score { type, value }",
        "analysis[].pv array": "lines[].pv joined string",
        "analysis[].first_move_score": "lines[].firstMoveScore",
        "score": "derive from analysis[0] cp/mate as { type, value }"
      }
    },
    {
      "id": 3,
      "area": "frontend useGameAnalysis / useChessGame",
      "change": "Optional one-shot game analysis path",
      "detail": "When PGN (or full move list) is available, call /api/analyze-game once instead of queuing N /api/analyze calls. Map timeline[i].analysis → analysis[i]. Keep per-ply path for live play / partial games."
    },
    {
      "id": 4,
      "area": "UX / timeouts",
      "change": "Progress + timeout for long games",
      "detail": "75-ply game took ~96s at movetime=200. Use movetime 100–200 for interactive; depth for batch. Show progress. Handle Render cold starts."
    },
    {
      "id": 5,
      "area": "error handling",
      "change": "Treat empty timeline as bad/empty PGN",
      "detail": "Hosted returns HTTP 200 with total_plies:0 for invalid PGN — do not treat as success."
    },
    {
      "id": 6,
      "area": "puzzle solution path",
      "change": "Already using hosted as fallback after stockfish.online 429",
      "detail": "No change required for single-best-move puzzle solutions beyond existing fallback chain."
    },
    {
      "id": 7,
      "area": "do not use",
      "change": "stockfish.online for full-game PGN",
      "detail": "No PGN endpoint; CORS/rate limits. Prefer hosted /analyze-game or local per-ply."
    }
  ],
  "recommendedIntegrationPlan": {
    "phase1": "Backend proxy + response adapter for /analyze-game (hosted primary, local loop fallback)",
    "phase2": "Wire game analysis UI to one-shot when full PGN known; keep incremental /analyze for live moves",
    "phase3": "Tune default movetime/multipv to match classification quality of current local pipeline"
  }
