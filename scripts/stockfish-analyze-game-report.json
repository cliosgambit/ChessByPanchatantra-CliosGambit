    "fullGameAnalyzeGameMs": 96407,
    "fullGameSettings": { "movetime": 200, "multipv": 3 }
  },
  "hostedEndpoints": {
    "GET /": { "ok": true, "sample": { "status": "online", "engine": "Stockfish", "version": "18.1" } },
    "POST /bestmove": { "input": { "fen": "string", "depth": 18 }, "notes": "single position" },
    "POST /multipv": { "input": { "fen": "string", "depth": 18, "multipv": 3 }, "notes": "single position MultiPV" },
    "POST /analyze": {
      "input": {
        "fen": "optional",
        "current_fen": "optional",
        "previous_fen": "optional",
        "depth": "optional",
        "movetime": "optional",
        "multipv": 1
      },
      "notes": "same semantic as CLIO local /api/analyze (FEN pair)"
    },
    "POST /analyze-game": {
      "input": {
        "pgn": "required string",
        "depth": "optional int",
        "movetime": "optional int",
        "multipv": "default 3"
      },
      "output": {
        "total_plies": "number",
        "timeline": [
          {
            "ply": 1,
            "move": "uci played to reach fen",
            "fen": "position after move",
            "analysis": "same shape as POST /analyze response"
          }
        ]
      },
      "invalidPgn": { "total_plies": 0, "timeline": [] }
    }
  },
  "analyzeGameLiveTests": {
    "full75PlyMovetime200": {
      "ok": true,
      "ms": 96407,
